# ==============================================================================
# HEXTAZ GAMES WEEK (HGW) — Configuration Environnement (.env)
# ==============================================================================

# Serveur HTTP (bind sur 127.0.0.1:3000 derrière cloudflared sur VM100)
PORT=3000
HOST=127.0.0.1
BASE_URL=https://hgw.hextaz.dev
SESSION_SECRET=remplacer_par_une_chaine_aleatoire_longue_64_chars

# Stockage SQLite WAL & Preuves
DATA_DIR=./data

# Mode démo : connexion de test, joueurs fictifs, replays d'exemple.
# Fermé en production (NODE_ENV=production) sauf si ALLOW_DEV_LOGIN=true. Ne JAMAIS l'activer pendant l'événement :
# n'importe qui pourrait se connecter en organisateur et générer des replays « Auteur ».
# En local (NODE_ENV ≠ production), il s'active tout seul tant que DISCORD_CLIENT_ID est vide.
ALLOW_DEV_LOGIN=false

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://hgw.hextaz.dev/api/auth/discord/callback

# Bot Discord.js (Validation des preuves dans #preuves + Slash Commands)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_PROOFS_CHANNEL_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
# Liste d'IDs Discord séparés par des virgules ayant les droits Admin sur le site et les boutons Discord
ADMIN_DISCORD_IDS=

# Serveur Trackmania Nations Forever (playit.gg / lien direct tmtp://)
TMNF_SERVER_LOGIN=hgw_server_login
TMNF_PLAYIT_ADDRESS=ton-tunnel.playit.gg:2350
TMNF_JOIN_URL=tmtp://#join=hgw_server_login
TMNF_WEEKLY_MAP_UID=HGW_WEEKLY_MAP_UID_A_REMPLACER
# Secret partagé avec infra/tmnf-xmlrpc-bridge.mjs (en-tête X-TMNF-Secret). Obligatoire :
# sans lui, le webhook /api/tmnf/webhook n'accepte que les sessions organisateur.
TMNF_WEBHOOK_SECRET=
